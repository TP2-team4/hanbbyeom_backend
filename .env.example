SERVER_PORT=8080

# 실행 전에 데이터베이스 생성
# 최초 Flyway 마이그레이션은 새 프로젝트 DB에서 실행하는 것을 권장
DB_URL=jdbc:postgresql://localhost:5432/hanbbyeom
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# JWT 구현에 필요: 암호학적으로 안전한 랜덤 바이트 32개 이상을 Base64로 인코딩한 값
# 각자 직접 생성해서 사용하며, 운영용 서명 키는 이 파일에 작성하거나 공유 X
JWT_SECRET_BASE64=REPLACE_WITH_YOUR_RANDOM_BASE64_SECRET
# JwtProperties에서 java.time.Duration 타입으로 바인딩
JWT_ACCESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# 이메일 발송 기능 구현 전까지는 선택 사항
# 587 포트는 STARTTLS 사용
# Gmail 사용 시 계정 비밀번호가 아닌 앱 비밀번호 사용
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 허용할 프론트엔드 Origin을 쉼표로 구분하여 작성
# Security/CORS 설정에서 이 값을 사용하도록 연결해야 함
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SWAGGER_ENABLED=true
