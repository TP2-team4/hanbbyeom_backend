# EC2 배포용 .env 템플릿
# EC2에서 이 파일을 .env로 복사한 뒤 값을 채워 사용
#   cp deploy.env.example .env
# 주의: 로컬 개발용 .env를 그대로 가져다 쓰지 말고, 운영 키는 새로 생성할 것

# --- DB (docker-compose가 postgres 컨테이너를 만들 때 사용) ---
# DB_URL / DB_USERNAME / DB_PASSWORD는 docker-compose.yaml이 아래 값으로 자동 구성하므로
# 여기에 따로 적지 않음
POSTGRES_DB=hanbbyeom
POSTGRES_USER=hanbbyeom
POSTGRES_PASSWORD=CHANGE_ME

# --- 외부 공개 포트 (기본 8080, EC2 보안 그룹에서 열어둔 포트와 맞출 것) ---
APP_PORT=8080

# --- 롤백용 이미지 태그 (평소엔 비워두면 latest로 동작) ---
# 롤백이 필요할 때만 커밋 해시 태그를 넣고 docker compose up -d
#   예: APP_IMAGE_TAG=a1b2c3d
APP_IMAGE_TAG=

# --- 시크릿: 아래 명령으로 각각 새로 생성해서 채울 것 ---
#   openssl rand -base64 32
JWT_SECRET_BASE64=REPLACE_WITH_YOUR_RANDOM_BASE64_SECRET
EMAIL_VERIFICATION_HMAC_SECRET_BASE64=REPLACE_WITH_YOUR_RANDOM_BASE64_SECRET
JWT_ACCESS_TOKEN_EXPIRATION=30m

# --- 메일 발송 (Gmail은 계정 비밀번호가 아닌 앱 비밀번호 사용) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- 프론트엔드 Origin ---
# 브라우저 요청을 허용할 프론트엔드 Origin 지정
# 여러 Origin은 쉼표로 구분하며 마지막 /는 제외
CORS_ALLOWED_ORIGINS=REPLACE_WITH_FRONTEND_ORIGIN

# --- Swagger 문서 공개 여부 (시연 후에는 false 권장) ---
SWAGGER_ENABLED=true
